{
  "name": "@drift/after-react",
  "version": "0.0.0",
  "description": "React bindings for @drift/after: a stable scope per component, disposed on unmount.",
  "license": "MIT",
  "author": "Gabriel Fonseca <gabriel@frontal.dev>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "react",
    "hooks",
    "async",
    "race-condition",
    "stale",
    "scope"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvfonseca/drift.git",
    "directory": "packages/after-react"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "check:package": "publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@drift/after": "workspace:^"
  }
}
