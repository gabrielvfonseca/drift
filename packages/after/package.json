{
  "name": "@drift/after",
  "version": "0.0.0",
  "description": "Validity-scoped async work: once a scope is invalidated, its pending work cannot commit state.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "async",
    "race-condition",
    "stale",
    "abort",
    "cancellation",
    "scope",
    "concurrency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvfonseca/drift.git",
    "directory": "packages/after"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "check:package": "publint && attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "1 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.0.5",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/gabrielvfonseca/drift/tree/main/packages/after#readme",
  "bugs": {
    "url": "https://github.com/gabrielvfonseca/drift/issues"
  },
  "author": {
    "name": "Gabriel Fonseca",
    "email": "gabriel@frontal.dev"
  }
}
